{
  "useTabs": true,
  "singleQuote": false,
  "jsxSingleQuote": false,
  "endOfLine": "auto",
  "trailingComma": "es5",
  "semi": true,
  "bracketSpacing": true,
  "arrowParens": "always",
  "overrides": [
    {
      "files": "**/*.json",
      "options": {
        "parser": "json",
        "useTabs": false
      }
    }
  ]
}