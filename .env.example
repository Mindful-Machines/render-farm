# RunPod network volume over its S3 API, for the rclone container on the manager node (see README).
# Keys: RunPod console → Settings → S3 API Keys. DATACENTER is the volume's datacenter, e.g. EU-RO-1.
RUNPOD_VOLUME_ID=
RCLONE_CONFIG_RUNPOD_TYPE=s3
RCLONE_CONFIG_RUNPOD_PROVIDER=Other
RCLONE_CONFIG_RUNPOD_ACCESS_KEY_ID=
RCLONE_CONFIG_RUNPOD_SECRET_ACCESS_KEY=
RCLONE_CONFIG_RUNPOD_REGION=DATACENTER
RCLONE_CONFIG_RUNPOD_ENDPOINT=https://s3api-DATACENTER.runpod.io/
